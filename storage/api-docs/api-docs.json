        "/api/payments/create": {
            "post": {
                "tags": [
                    "Payments"
                ],
                "summary": "Create a payment for membership or PT package",
                "operationId": "26dedad4479cbe8f6d6a694bd352a654",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "gym_id",
                                    "transaction_type",
                                    "type_id",
                                    "payment_method"
                                ],
                                "properties": {
                                    "gym_id": {
                                        "type": "integer"
                                    },
                                    "transaction_type": {
                                        "type": "string",
                                        "enum": [
                                            "membership",
                                            "pt"
                                        ]
                                    },
                                    "type_id": {
                                        "description": "membership_id or pt_package_id",
                                        "type": "integer"
                                    },
                                    "payment_method": {
                                        "type": "string",
                                        "enum": [
                                            "manual",
                                            "va",
                                            "qris"
                                        ]
                                    },
                                    "payment_type": {
                                        "description": "Required for PT",
                                        "type": "string",
                                        "enum": [
                                            "full_payment",
                                            "dp_payment"
                                        ]
                                    },
                                    "dp_percent": {
                                        "description": "Required if dp_payment",
                                        "type": "number",
                                        "example": 30
                                    },
                                    "promo_code": {
                                        "type": "string"
                                    },
                                    "signature_data": {
                                        "description": "Base64 signature for membership purchase",
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Payment created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean"
                                        },
                                        "data": {
                                            "properties": {
                                                "transaction_id": {
                                                    "type": "integer"
                                                },
                                                "snap_token": {
                                                    "type": "string"
                                                },
                                                "status": {
                                                    "type": "string"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
