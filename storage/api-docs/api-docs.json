        "/api/bookings": {
            "get": {
                "tags": [
                    "Bookings"
                ],
                "summary": "Get user's bookings",
                "operationId": "4535e967ef15bc76dadf1efa40192f0d",
                "parameters": [
                    {
                        "name": "status",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "confirmed",
                                "cancelled",
                                "completed",
                                "no-show"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Bookings retrieved successfully"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Bookings"
                ],
                "summary": "Book a class",
                "operationId": "43e6dcca842886074084b8db86af7802",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "schedule_id"
                                ],
                                "properties": {
                                    "schedule_id": {
                                        "type": "integer"
                                    },
                                    "booking_type": {
                                        "type": "string",
                                        "enum": [
                                            "in-person",
                                            "online"
                                        ],
                                        "example": "in-person"
                                    },
                                    "notes": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Booking created"
                    },
                    "409": {
                        "description": "Class is full or already booked"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/bookings/{id}/cancel": {
            "post": {
                "tags": [
                    "Bookings"
                ],
                "summary": "Cancel a booking (double verification)",
                "operationId": "9d8eeb663633d4d68870aa36255983b7",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "verification"
                                ],
                                "properties": {
                                    "reason": {
                                        "type": "string"
                                    },
                                    "verification": {
                                        "description": "Must type 'CANCEL' to confirm",
                                        "type": "string",
                                        "example": "CANCEL"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Booking cancelled"
                    },
                    "422": {
                        "description": "Verification failed"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
