{
    "openapi": "3.0.0",
    "info": {
        "title": "Arletta Gym API",
        "description": "REST API for Arletta Gym Landing Page — Authentication, Memberships, Trainers, Schedules, Bookings, Payments, Signatures",
        "contact": {
            "name": "Arletta Gym Developer",
            "email": "admin@arlettagym.com"
        },
